+    git(folder, 'init', '-b', 'main')
+    (folder / 'app.py').write_text('def login():\n    return True\n', encoding='utf-8')
+    git(folder, 'add', '-A')
+    git(folder, 'commit', '-m', 'first')
+    return folder
