diff --git a/tests/test_chat_first.py b/tests/test_chat_first.py
new file mode 100644
index 0000000..1896536
--- /dev/null
+++ b/tests/test_chat_first.py
@@ -0,0 +1,112 @@
+import time
+
+from PySide6.QtWidgets import QApplication, QCheckBox
+
+from desktop.app import Window
+from test_video_editing_studio import detailed_draft, generate
+
+
+def test_chat_starts_with_tools_hidden_and_one_click_back(tmp_path):
+    app = QApplication.instance() or QApplication([])
+    window = Window(tmp_path)
+    try:
+        assert window.pages.currentIndex() == window.page_indices['JARVIS Chat']
+        assert window.nav.isHidden()
+        window.tools_button.click()
+        assert not window.nav.isHidden()
+        window.open_section('Video Editor')
+        window.chat_home_button.click()
+        assert window.pages.currentIndex() == window.page_indices['JARVIS Chat']
+    finally:
+        window.close()
+        app.processEvents()
+
+
+def test_chat_open_checks_approval_settings_and_stop(tmp_path, monkeypatch):
+    app = QApplication.instance() or QApplication([])
+    window = Window(tmp_path)
+    opened = []
+    monkeypatch.setattr('desktop.app.QDesktopServices.openUrl',
+                        lambda url: opened.append(url.toString()) or True)
+    try:
+        window.prompt.setPlainText('Open Google Flow')
+        window.send()
+        assert not opened
+        assert window.chat_approval_label.text() == 'https://flow.google.com/'
+        window.chat_decline_button.click()
+        assert 'Action declined.' in window.transcript.toPlainText()
+
+        window.prompt.setPlainText('Higgsfield open பண்ணு')
+        window.send()
+        assert not opened
+        window.chat_approve_button.click()
+        assert opened == ['https://higgsfield.ai/ai-video']
+        assert window.pages.currentIndex() == window.page_indices['JARVIS Chat']
+
+        window.open_section('Settings & Safety')
+        page = window.pages.currentWidget()
+        setting = next(box for box in page.findChildren(QCheckBox) if box.text() == 'Higgsfield')
+        setting.setChecked(False)
+        window.prompt.setPlainText('Open Higgsfield')
+        window.send()
+        assert len(opened) == 1
+        assert 'disabled in Settings' in window.transcript.toPlainText()
+        window.prompt.setPlainText('Open Google Flow')
+        window.send()
+        assert window.chat_launch is not None
+        window.stop()
+        assert window.chat_launch is None
+        window.resume()
+        window.chat_approve_button.click()
+        assert len(opened) == 1
+    finally:
+        window.close()
+        app.processEvents()
+
+
+def test_chat_launches_only_the_configured_editor_after_approval(tmp_path, monkeypatch):
+    app = QApplication.instance() or QApplication([])
+    window = Window(tmp_path)
+    editor = tmp_path / 'CapCut.exe'
+    editor.touch()
+    window.store.set('editor_path:CapCut', str(editor))
+    launched = []
+    monkeypatch.setattr('desktop.app.launch_editor',
+                        lambda name, path: launched.append((name, path)) or 'CapCut launched.')
+    try:
+        window.prompt.setPlainText('CapCut open pannu')
+        window.send()
+        assert not launched
+        assert window.chat_approval_label.text() == str(editor)
+        window.chat_approve_button.click()
+        assert launched == [('CapCut', editor)]
+        assert 'CapCut launched.' in window.transcript.toPlainText()
+        assert window.worker is None
+    finally:
+        window.close()
+        app.processEvents()
+
+
+def test_video_command_keeps_the_plan_in_chat(tmp_path, monkeypatch):
+    app = QApplication.instance() or QApplication([])
+    window = Window(tmp_path)
+    monkeypatch.setattr(window, 'get_key', lambda _provider: 'fake-key')
+    try:
+        generate(window, detailed_draft())
+        window.prompt.setPlainText('/video ஒரு Tamil historical reel')
+        window.send(allow_notes=False)
+        assert window.worker is None
+        assert window.prompt.toPlainText() == '/video ஒரு Tamil historical reel'
+        window.send()
+        deadline = time.monotonic() + 5
+        while window.worker is not None and time.monotonic() < deadline:
+            app.processEvents()
+            time.sleep(0.005)
+        assert window.worker is None
+        assert window.pages.currentIndex() == window.page_indices['JARVIS Chat']
+        assert 'Slow push-in' in window.transcript.toPlainText()
+        assert '/video ஒரு Tamil historical reel' in window.transcript.toPlainText()
+        assert window.video_plan is not None
+    finally:
+        window.close()
+        app.processEvents()
