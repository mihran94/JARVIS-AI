+def test_a_rejected_key_never_reaches_the_backup_provider(tmp_path, monkeypatch):
+    """A bad key is a configuration problem, not a reason to spend the backup."""
+    win, seen = chat_window(tmp_path, monkeypatch,
+                            lambda request: httpx.Response(401, text='private-secret'))
+    try:
+        win.backup_consent.setChecked(True)
+        win.backup_provider.setCurrentText('Gemini')
+        ask(win)
+        assert len(seen) == 1, 'a rejected key reached the backup provider'
+        transcript = win.transcript.toPlainText()
+        assert 'private-secret' not in transcript
+        assert 'KEY' in transcript.upper() or 'rejected' in transcript.lower()
+    finally:
+        win.close()
+
+
+def test_an_empty_key_stops_the_chat_before_any_request(tmp_path, monkeypatch):
+    """No key, no request, and a sentence that says which key is missing."""
+    win, seen = chat_window(tmp_path, monkeypatch,
+                            lambda request: httpx.Response(200, text=STREAM_ANSWER))
+    try:
+        monkeypatch.setattr(win, 'get_key', lambda provider: '')
+        ask(win)
+        assert seen == [], 'a request was sent without a key'
+        assert 'key' in win.transcript.toPlainText().lower()
+    finally:
+        win.close()
