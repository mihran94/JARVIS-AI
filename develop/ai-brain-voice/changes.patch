+# ── the normal JARVIS chat flow ──────────────────────────────────────────────
+
+def chat_window(tmp_path, monkeypatch, handler, *, chat_provider='OpenAI'):
+    """A window wired to a fake transport, with the key store faked out.
+
+    The real `Window.send()`, the real `ChatWorker`, the real `ProviderRouter`
+    and the real `providers.chat.stream_chat` all run. Only the HTTP
+    transport is replaced, so the provider, the model and the key that reach
+    the wire are the ones the application really uses.
+    """
+    win = window(tmp_path)
+    seen = []
+
+    def respond(request):
+        seen.append(request)
+        return handler(request)
+
+    win.router._transport = httpx.MockTransport(respond)
+    monkeypatch.setattr(win, 'get_key', lambda provider: 'fake-key')
+    monkeypatch.setattr(desktop.QMessageBox, 'warning',
+                        staticmethod(lambda *args, **kwargs: None))
+    win.provider.setCurrentText(chat_provider)
+    win.save_provider()
+    return win, seen
+
+
+def ask(win, text='hello there'):
+    """Send one message and wait for the answer."""
+    win.prompt.setPlainText(text)
+    win.send()
+    worker = win.worker
+    if worker is not None:
+        worker.wait(8000)
+    QApplication.instance().processEvents()
+
+
+STREAM_ANSWER = (
+    'data: {"choices":[{"delta":{"content":"Vanakkam"}}]}\n\n'
+    'data: [DONE]\n\n'
+)
+
+
+def test_the_chosen_provider_really_receives_the_request(tmp_path, monkeypatch):
+    """The provider chosen in settings is the one the chat flow calls."""
+    win, seen = chat_window(tmp_path, monkeypatch,
+                            lambda request: httpx.Response(200, text=STREAM_ANSWER))
+    try:
+        ask(win)
+        assert seen, 'no request reached the provider'
+        assert str(seen[0].url) == PROVIDERS['OpenAI'].endpoint
+        body = json.loads(seen[0].content)
+        assert body['model'] == PROVIDERS['OpenAI'].default_model
+        assert seen[0].headers['Authorization'] == 'Bearer fake-key'
+        assert 'Vanakkam' in win.transcript.toPlainText()
+    finally:
+        win.close()
+
+
+def test_the_profile_decides_the_model_that_is_sent(tmp_path, monkeypatch):
+    """Choosing Deep must change the model in the real request."""
+    win, seen = chat_window(tmp_path, monkeypatch,
+                            lambda request: httpx.Response(200, text=STREAM_ANSWER),
+                            chat_provider='Gemini')
+    try:
+        win.provider_profile.setCurrentIndex(win.provider_profile.findData('deep'))
+        win.model.setText(profiles.PROFILE_MODELS['Gemini']['deep'])
+        win.save_provider()
+        ask(win)
+        assert seen, 'no request reached the provider'
+        body = json.loads(seen[0].content)
+        assert body['model'] == profiles.PROFILE_MODELS['Gemini']['deep']
+    finally:
+        win.close()
+
