+def test_the_backup_provider_is_not_used_when_it_is_not_enabled(tmp_path, monkeypatch):
+    """No consent, no second provider, and no second bill."""
+    win, seen = chat_window(tmp_path, monkeypatch,
+                            lambda request: httpx.Response(503))
+    try:
+        win.backup_consent.setChecked(False)
+        ask(win)
+        assert len(seen) == 1, 'the backup provider was called without consent'
+        assert str(seen[0].url) == PROVIDERS['OpenAI'].endpoint
+    finally:
+        win.close()
+
+
+def test_the_backup_provider_is_used_when_it_is_enabled_and_allowed(tmp_path, monkeypatch):
+    """A provider that is not answering is the one case the backup is for."""
+    win, seen = chat_window(tmp_path, monkeypatch,
+                            lambda request: httpx.Response(503))
+    try:
+        win.backup_consent.setChecked(True)
+        win.backup_provider.setCurrentText('Gemini')
+        ask(win)
+        urls = [str(request.url) for request in seen]
+        assert urls == [PROVIDERS['OpenAI'].endpoint, PROVIDERS['Gemini'].endpoint]
+        # The backup consumed the consent; it is a single attempt.
+        assert win.backup_consent.isChecked() is False
+    finally:
+        win.close()
+
