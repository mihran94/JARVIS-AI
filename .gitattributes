# Everything is stored with Unix line endings and checked out with Unix line
# endings, so a checkout looks the same on every machine and the source
# integrity manifest holds on all of them.
* text=auto eol=lf

# The Windows batch files are the exception. Two of the scripts use a label
# and a goto. cmd.exe looks for a label in a batch file by reading it line by
# line, and a file that only has Unix line endings can fail with "The system
# cannot find the batch label specified". The files are stored with Unix line
# endings in the repository and are written with Windows line endings when
# they are checked out.
*.cmd text eol=crlf
*.bat text eol=crlf

# The images and the archives are not text.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.jar binary
*.zip binary
*.apk binary
