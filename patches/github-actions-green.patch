From cb59afddd94afdc0bc7ed1f8975121c1f7660b37 Mon Sep 17 00:00:00 2001
From: c <a@b>
Date: Thu, 12 Nov 2026 00:14:47 +0000
Subject: [PATCH] fix

---
 .github/workflows/tests.yml           |  9 +++++
 .github/workflows/windows-release.yml | 53 +++++++++++++++++++++++++++
 2 files changed, 62 insertions(+)
 create mode 100644 .github/workflows/windows-release.yml

diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index 3862b81..fe2674e 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -5,6 +5,9 @@ permissions:
 jobs:
   test:
     strategy:
+      # Report both operating systems even when one fails, so a Linux only
+      # problem never hides the Windows result.
+      fail-fast: false
       matrix:
         os: [ubuntu-latest, windows-latest]
     runs-on: ${{ matrix.os }}
@@ -15,5 +18,11 @@ jobs:
       - uses: actions/setup-python@v5
         with:
           python-version: '3.12'
+      - name: Install the Qt runtime libraries
+        if: runner.os == 'Linux'
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y --no-install-recommends \
+            libegl1 libglib2.0-0 libdbus-1-3 libxkbcommon0 libfontconfig1
       - run: python -m pip install -r requirements-dev.txt
       - run: python -m pytest -q
diff --git a/.github/workflows/windows-release.yml b/.github/workflows/windows-release.yml
new file mode 100644
index 0000000..c569400
--- /dev/null
+++ b/.github/workflows/windows-release.yml
@@ -0,0 +1,53 @@
+name: Windows desktop build
+on:
+  workflow_dispatch:
+  push:
+    branches: [main]
+    paths:
+      - 'desktop/**'
+      - 'providers/**'
+      - 'security/**'
+      - 'core/**'
+      - 'automation/**'
+      - 'agents/**'
+      - 'developer_studio/**'
+      - 'voice/**'
+      - 'remote/**'
+      - 'main.py'
+      - 'requirements*.txt'
+      - 'scripts/release_manifest.py'
+      - '.github/workflows/windows-release.yml'
+permissions:
+  contents: read
+jobs:
+  build:
+    runs-on: windows-latest
+    timeout-minutes: 60
+    env:
+      QT_QPA_PLATFORM: offscreen
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      - name: Run the test suite
+        run: |
+          python -m pip install -r requirements-dev.txt
+          python -m pytest -q
+      - name: Build the unsigned application
+        run: |
+          python -m pip install pyinstaller==6.12.0
+          python -m PyInstaller --noconfirm --clean --windowed --onedir --name JarvisAI --hidden-import keyring.backends.Windows main.py
+      - name: Write the release manifest
+        run: >
+          python scripts/release_manifest.py dist/JarvisAI dist/JarvisAI-RELEASE.txt
+          --version 0.3.0 --revision ${{ github.sha }} --channel beta
+      - name: Upload the build
+        uses: actions/upload-artifact@v4
+        with:
+          name: JarvisAI-windows-x64
+          path: |
+            dist/JarvisAI
+            dist/JarvisAI-RELEASE.txt
+          retention-days: 14
+          if-no-files-found: error
-- 
2.39.5

