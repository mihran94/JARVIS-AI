From ee6236d54fae959058da5dfb8485cc8eb4df4307 Mon Sep 17 00:00:00 2001
From: c <a@b>
Date: Thu, 12 Nov 2026 00:15:04 +0000
Subject: [PATCH] Add the Android debug APK build workflow

---
 .github/workflows/android-debug-apk.yml | 54 +++++++++++++++++++++++++
 1 file changed, 54 insertions(+)
 create mode 100644 .github/workflows/android-debug-apk.yml

diff --git a/.github/workflows/android-debug-apk.yml b/.github/workflows/android-debug-apk.yml
new file mode 100644
index 0000000..f445f7d
--- /dev/null
+++ b/.github/workflows/android-debug-apk.yml
@@ -0,0 +1,54 @@
+name: Android debug APK build
+on:
+  workflow_dispatch:
+  push:
+    branches: [main]
+    paths:
+      - 'app/**'
+      - 'core/**'
+      - 'feature/**'
+      - 'gradle/**'
+      - 'build.gradle.kts'
+      - 'gradle.properties'
+      - 'gradlew'
+      - 'gradlew.bat'
+      - '.github/workflows/android-debug-apk.yml'
+permissions:
+  contents: read
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+          cache: gradle
+      - name: Set up the Android SDK
+        uses: android-actions/setup-android@v3
+      - name: Install the SDK packages
+        run: sdkmanager "platform-tools" "platforms;android-35" "build-tools;35.0.0"
+      - name: Restore the Gradle wrapper
+        # The wrapper JAR travels as a base64 sidecar, so it is restored first.
+        run: |
+          bash gradle/wrapper/restore-wrapper.sh
+          chmod +x gradlew
+      - name: Build the debug APK
+        # The debug variant uses the automatic debug key. The release signing
+        # key is never involved in this workflow.
+        run: ./gradlew :app:assembleDebug --no-daemon --console=plain
+      - name: Record the APK digest
+        run: |
+          sha256sum app/build/outputs/apk/debug/app-debug.apk > app-debug.apk.sha256
+          cat app-debug.apk.sha256
+      - name: Upload the APK
+        uses: actions/upload-artifact@v4
+        with:
+          name: JarvisBlue-android-debug-apk
+          path: |
+            app/build/outputs/apk/debug/app-debug.apk
+            app-debug.apk.sha256
+          retention-days: 14
+          if-no-files-found: error
-- 
